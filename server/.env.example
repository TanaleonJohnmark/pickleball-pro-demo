# Copy to .env for local use. On Render these are set in the dashboard.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ppdemo"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pickleball_test"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
CLUB_TIMEZONE="Asia/Manila"
NODE_ENV=development

# --- Demo mode ---
DEMO_MODE=true
DEMO_RESET_HOURS=6
# Link for the "Get this for your court" button (your Facebook page or m.me link)
DEMO_CONTACT_URL="https://www.facebook.com/"

# Your own private super-admin login (recreated after every reset)
ADMIN_NAME="Johnmark Tanaleon"
ADMIN_EMAIL="you@example.com"
